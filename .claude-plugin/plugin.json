{
  "name": "interfluence",
  "version": "0.2.12",
  "description": "[DEPRECATED — use intervoice] Analyze your writing style and adapt Claude's output to sound like you. Replaced by intervoice, which reads one global multi-register profile instead of per-project glob-routed files.",
  "author": {
    "name": "mistakeknot",
    "email": "mistakeknot@vibeguider.org"
  },
  "skills": [
    "./skills/analyze",
    "./skills/apply",
    "./skills/compare",
    "./skills/ingest",
    "./skills/optimize",
    "./skills/refine"
  ],
  "commands": [
    "./commands/interfluence.md"
  ],
  "agents": [
    "./agents/voice-analyzer.md"
  ],
  "mcpServers": {
    "interfluence": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/dist/bundle.js"
      ],
      "env": {}
    }
  },
  "peerDependencies": [
    "intercheck"
  ]
}
